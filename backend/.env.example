# Django Settings
# 生产环境必须设置 DEBUG=False, 并提供随机 SECRET_KEY 与具体 ALLOWED_HOSTS
DEBUG=True
SECRET_KEY=change-me-in-production-abc123def456ghi789jkl012mno345pqr
ALLOWED_HOSTS=*

# Database (MySQL for production, SQLite for dev)
DB_ENGINE=django.db.backends.mysql
DB_NAME=testautomation
DB_USER=root
DB_PASSWORD=root
DB_HOST=127.0.0.1
DB_PORT=3306

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MIN=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS (生产环境请设为 False, 并配置具体来源)
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173

# 接口调试出站安全 (生产环境默认禁止访问内网; 本地测试内网服务可临时设为 True)
API_DEBUG_ALLOW_PRIVATE_NETWORK=True

# 认证限流
LOGIN_THROTTLE_RATE=10/min
REGISTER_THROTTLE_RATE=20/hour
